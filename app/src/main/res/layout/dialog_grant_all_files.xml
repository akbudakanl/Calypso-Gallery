<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/grant_all_files_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="@dimen/compact_dialog_padding">

    <!-- Animated folder + check emblem matching the onboarding & vault emblem language -->
    <FrameLayout
        android:id="@+id/grant_all_files_emblem"
        android:layout_width="@dimen/compact_dialog_emblem_size"
        android:layout_height="@dimen/compact_dialog_emblem_size"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp">

        <View
            android:id="@+id/grant_all_files_halo"
            android:layout_width="@dimen/compact_dialog_emblem_size"
            android:layout_height="@dimen/compact_dialog_emblem_size"
            android:layout_gravity="center" />

        <FrameLayout
            android:id="@+id/grant_all_files_emblem_core"
            android:layout_width="@dimen/compact_dialog_emblem_core_size"
            android:layout_height="@dimen/compact_dialog_emblem_core_size"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/grant_all_files_image"
                android:layout_width="@dimen/compact_dialog_emblem_icon_size"
                android:layout_height="@dimen/compact_dialog_emblem_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_onboarding_folder" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/grant_all_files_badge_dot"
            android:layout_width="@dimen/compact_dialog_emblem_badge_size"
            android:layout_height="@dimen/compact_dialog_emblem_badge_size"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp">

            <ImageView
                android:id="@+id/grant_all_files_badge_icon"
                android:layout_width="@dimen/compact_dialog_emblem_badge_icon_size"
                android:layout_height="@dimen/compact_dialog_emblem_badge_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_onboarding_check" />
        </FrameLayout>
    </FrameLayout>

    <!-- Plain TextViews (not MyTextView) so setupDialogStuff()'s updateTextColors() cannot
         overwrite AppearancePalette foregrounds (secondary, primary, onPrimary) with textColor. -->
    <TextView
        android:id="@+id/grant_all_files_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="-0.01"
        android:text="@string/onboarding_all_files_title"
        android:textSize="@dimen/compact_dialog_title_text_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/grant_all_files_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.28"
        android:text="@string/hidden_all_files"
        android:textSize="@dimen/compact_dialog_body_medium_text_size" />

    <TextView
        android:id="@+id/grant_all_files_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.25"
        android:padding="@dimen/compact_dialog_note_padding"
        android:text="@string/onboarding_all_files_offline_desc"
        android:textSize="@dimen/compact_dialog_note_text_size" />

    <LinearLayout
        android:id="@+id/grant_all_files_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/grant_all_files_negative"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="@string/cancel"
            android:textSize="@dimen/compact_dialog_action_medium_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/grant_all_files_positive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/onboarding_grant_access"
            android:textSize="@dimen/compact_dialog_action_medium_text_size"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
