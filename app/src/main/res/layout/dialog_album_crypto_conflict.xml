<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/activity_margin"
        android:paddingTop="@dimen/medium_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:paddingBottom="@dimen/small_margin">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/album_crypto_conflict_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/medium_margin"
            android:textSize="@dimen/normal_text_size" />

        <RadioGroup
            android:id="@+id/album_crypto_conflict_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/album_crypto_conflict_rename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/album_crypto_conflict_merge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin" />
        </RadioGroup>

        <org.fossify.commons.views.MyAppCompatCheckbox
            android:id="@+id/album_crypto_delete_identical_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:paddingStart="@dimen/big_margin"
            android:paddingTop="@dimen/tiny_margin"
            android:paddingBottom="@dimen/small_margin"
            android:text="@string/album_crypto_delete_identical_source"
            android:textSize="@dimen/smaller_text_size" />

        <org.fossify.commons.views.MyAppCompatCheckbox
            android:id="@+id/album_crypto_dont_ask_again"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_margin"
            android:paddingTop="@dimen/small_margin"
            android:paddingBottom="@dimen/small_margin"
            android:text="@string/album_crypto_dont_ask_again"
            android:textSize="@dimen/smaller_text_size" />
    </LinearLayout>
</ScrollView>
