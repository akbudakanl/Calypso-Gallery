<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/about_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/about_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/about_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <org.fossify.gallery.views.MaxWidthLinearLayout
            android:id="@+id/about_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/big_margin"
            android:paddingTop="@dimen/activity_margin"
            android:paddingEnd="@dimen/big_margin"
            android:paddingBottom="@dimen/big_margin"
            app:maxWidth="@dimen/settings_max_content_width">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textSize="24sp" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tiny_margin"
                android:textSize="14sp" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/big_margin"
                android:lineSpacingExtra="3dp"
                android:text="@string/about_fork_description" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_modification_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_margin"
                android:lineSpacingExtra="3dp"
                android:text="@string/about_modification_notice" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_license_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/big_margin"
                android:fontFamily="sans-serif-medium"
                android:text="@string/about_license_heading"
                android:textSize="18sp" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_copyright_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tiny_margin"
                android:lineSpacingExtra="3dp"
                android:text="@string/about_copyright_notice" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_license_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:lineSpacingExtra="3dp"
                android:text="@string/about_gpl_notice" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_gpl_license"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin"
                android:text="@string/about_read_gpl_license" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_source_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/big_margin"
                android:fontFamily="sans-serif-medium"
                android:text="@string/about_source_heading"
                android:textSize="18sp" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_source_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tiny_margin"
                android:lineSpacingExtra="3dp"
                android:text="@string/about_corresponding_source_notice" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_fork_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin"
                android:text="@string/about_fork_source" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_release_sources"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin"
                android:text="@string/about_release_sources" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_fork_issues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin"
                android:text="@string/about_fork_issues" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_upstream_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin"
                android:text="@string/about_upstream_source" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_upstream_project"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin"
                android:text="@string/about_upstream_project" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_help_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/big_margin"
                android:fontFamily="sans-serif-medium"
                android:text="@string/about_help_heading"
                android:textSize="18sp" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_faq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin"
                android:text="@string/about_faq" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/about_third_party_licenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin"
                android:text="@string/about_third_party_licenses" />

        </org.fossify.gallery.views.MaxWidthLinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
