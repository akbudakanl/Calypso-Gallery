<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appearance_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/appearance_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/appearance_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/appearance_title"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/appearance_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <org.fossify.gallery.views.MaxWidthLinearLayout
            android:id="@+id/appearance_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp"
            app:maxWidth="@dimen/settings_max_content_width">

            <!-- OTOMATİK -->
            <TextView
                android:id="@+id/appearance_auto_section_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/appearance_automatic" />

            <LinearLayout
                android:id="@+id/appearance_auto_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/appearance_follow_system_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/appearance_follow_system_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/follow_system_theme"
                            android:textSize="14.5sp" />

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/appearance_follow_system_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/follow_system_theme_summary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <org.fossify.commons.views.MyMaterialSwitch
                        android:id="@+id/appearance_follow_system"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:clickable="false"
                        android:focusable="false"
                        android:saveEnabled="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- TEMA -->
            <TextView
                android:id="@+id/appearance_theme_section_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/theme" />

            <LinearLayout
                android:id="@+id/appearance_theme_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Row 1: Koyu | Açık -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/appearance_dark_row"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/appearance_dark_swatch_1"
                                android:layout_width="15dp"
                                android:layout_height="15dp" />

                            <View
                                android:id="@+id/appearance_dark_swatch_2"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <View
                                android:id="@+id/appearance_dark_swatch_3"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:id="@+id/appearance_dark_radio"
                                android:layout_width="18dp"
                                android:layout_height="18dp" />
                        </LinearLayout>

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/dark_theme"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/appearance_light_row"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/appearance_light_swatch_1"
                                android:layout_width="15dp"
                                android:layout_height="15dp" />

                            <View
                                android:id="@+id/appearance_light_swatch_2"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <View
                                android:id="@+id/appearance_light_swatch_3"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:id="@+id/appearance_light_radio"
                                android:layout_width="18dp"
                                android:layout_height="18dp" />
                        </LinearLayout>

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/light_theme"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Gece Mavisi | Sıcak Kağıt -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/appearance_navy_row"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/appearance_navy_swatch_1"
                                android:layout_width="15dp"
                                android:layout_height="15dp" />

                            <View
                                android:id="@+id/appearance_navy_swatch_2"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <View
                                android:id="@+id/appearance_navy_swatch_3"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:id="@+id/appearance_navy_radio"
                                android:layout_width="18dp"
                                android:layout_height="18dp" />
                        </LinearLayout>

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/theme_midnight_blue"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/appearance_paper_row"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/appearance_paper_swatch_1"
                                android:layout_width="15dp"
                                android:layout_height="15dp" />

                            <View
                                android:id="@+id/appearance_paper_swatch_2"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <View
                                android:id="@+id/appearance_paper_swatch_3"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:id="@+id/appearance_paper_radio"
                                android:layout_width="18dp"
                                android:layout_height="18dp" />
                        </LinearLayout>

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/theme_warm_paper"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 3: Kadife Mor | Yumuşak Mercan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/appearance_violet_row"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/appearance_violet_swatch_1"
                                android:layout_width="15dp"
                                android:layout_height="15dp" />

                            <View
                                android:id="@+id/appearance_violet_swatch_2"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <View
                                android:id="@+id/appearance_violet_swatch_3"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:id="@+id/appearance_violet_radio"
                                android:layout_width="18dp"
                                android:layout_height="18dp" />
                        </LinearLayout>

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/theme_velvet_violet"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/appearance_coral_row"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/appearance_coral_swatch_1"
                                android:layout_width="15dp"
                                android:layout_height="15dp" />

                            <View
                                android:id="@+id/appearance_coral_swatch_2"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <View
                                android:id="@+id/appearance_coral_swatch_3"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:id="@+id/appearance_coral_radio"
                                android:layout_width="18dp"
                                android:layout_height="18dp" />
                        </LinearLayout>

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/theme_soft_coral"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 4: Derin Orman | Özel -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/appearance_forest_row"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/appearance_forest_swatch_1"
                                android:layout_width="15dp"
                                android:layout_height="15dp" />

                            <View
                                android:id="@+id/appearance_forest_swatch_2"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <View
                                android:id="@+id/appearance_forest_swatch_3"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:id="@+id/appearance_forest_radio"
                                android:layout_width="18dp"
                                android:layout_height="18dp" />
                        </LinearLayout>

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/theme_deep_forest"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/appearance_custom_row"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/appearance_custom_swatch_1"
                                android:layout_width="15dp"
                                android:layout_height="15dp" />

                            <View
                                android:id="@+id/appearance_custom_swatch_2"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <View
                                android:id="@+id/appearance_custom_swatch_3"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="4dp" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:id="@+id/appearance_custom_radio"
                                android:layout_width="18dp"
                                android:layout_height="18dp" />
                        </LinearLayout>

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/custom"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ÖZEL RENKLER -->
            <TextView
                android:id="@+id/appearance_custom_colors_section_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/custom_colors" />

            <LinearLayout
                android:id="@+id/appearance_custom_colors_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/appearance_text_color_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/text_color"
                        android:textSize="14.5sp" />

                    <View
                        android:id="@+id/appearance_text_color_swatch"
                        android:layout_width="28dp"
                        android:layout_height="28dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/appearance_background_color_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/background_color"
                        android:textSize="14.5sp" />

                    <View
                        android:id="@+id/appearance_background_color_swatch"
                        android:layout_width="28dp"
                        android:layout_height="28dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/appearance_primary_color_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/primary_color"
                        android:textSize="14.5sp" />

                    <View
                        android:id="@+id/appearance_primary_color_swatch"
                        android:layout_width="28dp"
                        android:layout_height="28dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/appearance_saved_themes_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/saved_themes"
                        android:textSize="14.5sp" />

                    <ImageView
                        android:id="@+id/appearance_saved_themes_chevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings_chevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- ÖNİZLEME -->
            <TextView
                android:id="@+id/appearance_preview_section_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/appearance_preview" />

            <LinearLayout
                android:id="@+id/appearance_preview_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/appearance_preview_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/appearance_preview_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/appearance_preview_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="9dp"
                    android:text="@string/appearance_preview_button"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/appearance_contrast_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.25"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- YAZI TİPİ -->
            <TextView
                android:id="@+id/appearance_font_section_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/font" />

            <LinearLayout
                android:id="@+id/appearance_font_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/appearance_font_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/app_font"
                            android:textSize="14.5sp" />

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/appearance_font_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/appearance_font_chevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings_chevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- ALBÜM TÜRÜ İKONLARI -->
            <TextView
                android:id="@+id/appearance_album_icons_section_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/album_type_icons" />

            <LinearLayout
                android:id="@+id/appearance_album_icons_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/appearance_show_virtual_album_icon_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="54dp"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <org.fossify.commons.views.MyMaterialSwitch
                        android:id="@+id/appearance_show_virtual_album_icon"
                        style="@style/SettingsSwitchStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/virtual_folders" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/appearance_show_favorites_album_icon_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="54dp"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <org.fossify.commons.views.MyMaterialSwitch
                        android:id="@+id/appearance_show_favorites_album_icon"
                        style="@style/SettingsSwitchStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/favorites_album" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/appearance_show_excluded_album_icon_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="54dp"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <org.fossify.commons.views.MyMaterialSwitch
                        android:id="@+id/appearance_show_excluded_album_icon"
                        style="@style/SettingsSwitchStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/excluded_folders_album" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/appearance_show_hidden_album_icon_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="54dp"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <org.fossify.commons.views.MyMaterialSwitch
                        android:id="@+id/appearance_show_hidden_album_icon"
                        style="@style/SettingsSwitchStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hidden_folders_album" />
                </RelativeLayout>
            </LinearLayout>

            <!-- YEDEKLEME -->
            <TextView
                android:id="@+id/appearance_backup_section_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/appearance_backup_section" />

            <LinearLayout
                android:id="@+id/appearance_backup_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/appearance_backup_saved_themes_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="54dp"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <org.fossify.commons.views.MyMaterialSwitch
                        android:id="@+id/appearance_backup_saved_themes"
                        style="@style/SettingsSwitchStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_saved_themes_to_storage" />
                </RelativeLayout>
            </LinearLayout>

        </org.fossify.gallery.views.MaxWidthLinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
