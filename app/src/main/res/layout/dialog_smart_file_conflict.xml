<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/smart_conflict_scrollview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/smart_conflict_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/activity_margin"
        android:paddingTop="@dimen/medium_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:paddingBottom="@dimen/small_margin">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/smart_conflict_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/medium_margin"
            android:textSize="@dimen/normal_text_size"
            tools:text="File &quot;photo.jpg&quot; already exists (1 / 3)" />

        <LinearLayout
            android:id="@+id/smart_conflict_comparison_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Incoming / Source side -->
            <LinearLayout
                android:id="@+id/smart_conflict_source_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/tiny_margin"
                android:layout_weight="1"
                android:orientation="vertical">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/smart_conflict_source_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:text="@string/smart_conflict_incoming_label"
                    android:textSize="@dimen/smaller_text_size"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/smart_conflict_source_preview_frame"
                    android:layout_width="match_parent"
                    android:layout_height="136dp"
                    android:background="#1A808080"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/smart_conflict_source_thumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/smart_conflict_incoming_label"
                        android:padding="2dp"
                        android:scaleType="fitCenter" />

                    <ProgressBar
                        android:id="@+id/smart_conflict_source_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center" />

                    <ImageView
                        android:id="@+id/smart_conflict_source_video_badge"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/circle_black_background"
                        android:padding="4dp"
                        android:src="@drawable/ic_play_vector"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/smart_conflict_source_error_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/small_margin"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_vector_warning_colored" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tiny_margin"
                            android:gravity="center"
                            android:text="@string/smart_conflict_corrupted_unreadable"
                            android:textSize="@dimen/smaller_text_size" />
                    </LinearLayout>
                </FrameLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/smart_conflict_source_integrity_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="@dimen/tiny_margin"
                    android:text="@string/smart_conflict_integrity_failed"
                    android:textColor="#E53935"
                    android:textSize="@dimen/smaller_text_size"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/smart_conflict_source_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:paddingTop="@dimen/tiny_margin"
                    android:textSize="@dimen/smaller_text_size"
                    tools:text="2.4 MB\n1920×1080\n15.11.2026" />
            </LinearLayout>

            <!-- Existing / Target side -->
            <LinearLayout
                android:id="@+id/smart_conflict_existing_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/tiny_margin"
                android:layout_weight="1"
                android:orientation="vertical">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/smart_conflict_existing_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:text="@string/smart_conflict_existing_label"
                    android:textSize="@dimen/smaller_text_size"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/smart_conflict_existing_preview_frame"
                    android:layout_width="match_parent"
                    android:layout_height="136dp"
                    android:background="#1A808080"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/smart_conflict_existing_thumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/smart_conflict_existing_label"
                        android:padding="2dp"
                        android:scaleType="fitCenter" />

                    <ProgressBar
                        android:id="@+id/smart_conflict_existing_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center" />

                    <ImageView
                        android:id="@+id/smart_conflict_existing_video_badge"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/circle_black_background"
                        android:padding="4dp"
                        android:src="@drawable/ic_play_vector"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/smart_conflict_existing_error_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/small_margin"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_vector_warning_colored" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tiny_margin"
                            android:gravity="center"
                            android:text="@string/smart_conflict_corrupted_unreadable"
                            android:textSize="@dimen/smaller_text_size" />
                    </LinearLayout>
                </FrameLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/smart_conflict_existing_integrity_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="@dimen/tiny_margin"
                    android:text="@string/smart_conflict_integrity_failed"
                    android:textColor="#E53935"
                    android:textSize="@dimen/smaller_text_size"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/smart_conflict_existing_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:paddingTop="@dimen/tiny_margin"
                    android:textSize="@dimen/smaller_text_size"
                    tools:text="2.4 MB\n1920×1080\n14.11.2026" />
            </LinearLayout>
        </LinearLayout>

        <org.fossify.commons.views.MyTextView
            android:id="@+id/smart_conflict_preview_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.65"
            android:gravity="center"
            android:paddingTop="@dimen/small_margin"
            android:paddingBottom="@dimen/small_margin"
            android:text="@string/smart_conflict_tap_to_preview"
            android:textSize="@dimen/smaller_text_size" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/smart_conflict_difference_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tiny_margin"
            android:layout_marginBottom="@dimen/small_margin"
            android:background="#1A808080"
            android:gravity="center"
            android:paddingStart="@dimen/medium_margin"
            android:paddingTop="@dimen/small_margin"
            android:paddingEnd="@dimen/medium_margin"
            android:paddingBottom="@dimen/small_margin"
            android:text="@string/smart_conflict_comparing"
            android:textSize="@dimen/smaller_text_size" />

        <RadioGroup
            android:id="@+id/smart_conflict_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/tiny_margin">

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/smart_conflict_keep_both"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin"
                tools:text="Keep both" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/smart_conflict_overwrite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin"
                tools:text="Overwrite" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/smart_conflict_skip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin"
                tools:text="Skip" />
        </RadioGroup>

        <org.fossify.commons.views.MyAppCompatCheckbox
            android:id="@+id/smart_conflict_apply_to_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tiny_margin"
            android:paddingTop="@dimen/small_margin"
            android:paddingBottom="@dimen/small_margin"
            android:visibility="gone"
            tools:text="Apply to all" />
    </LinearLayout>
</ScrollView>
