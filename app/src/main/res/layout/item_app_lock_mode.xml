<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_app_lock_mode_holder"
    style="@style/CalypsoCardRowStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="32dp"
    android:visibility="gone">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/settings_app_lock_mode_label"
        style="@style/SettingsTextLabelStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="28dp"
        android:text="@string/app_lock_mode_label" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/settings_app_lock_mode"
        style="@style/SettingsTextValueStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/settings_app_lock_mode_label"
        android:layout_marginEnd="28dp"
        tools:text="@string/app_lock_mode_cold_start" />
</RelativeLayout>
