<?xml version="1.0" encoding="utf-8"?>
<org.fossify.gallery.views.MaxWidthLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vault_security_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/normal_margin"
    app:maxWidth="@dimen/vault_security_max_width">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/vault_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/normal_margin"
        app:tabGravity="fill"
        app:tabMode="fixed" />

    <!-- Framed lock emblem with ambient pulse ring and shutter unlock motion
         (visible in credential-entry and re-auth modes). -->
    <FrameLayout
        android:id="@+id/vault_lock_emblem"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <View
            android:id="@+id/vault_lock_halo"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_gravity="center" />

        <FrameLayout
            android:id="@+id/vault_lock_emblem_core"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center">

            <org.fossify.gallery.views.VaultShutterLockView
                android:id="@+id/vault_unlock_emblem"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center" />
        </FrameLayout>
    </FrameLayout>

    <org.fossify.commons.views.MyTextView
        android:id="@+id/vault_lock_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:letterSpacing="-0.02"
        android:text="@string/biometric_unlock_vault"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/vault_status_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/normal_margin"
        android:gravity="center"
        android:textSize="@dimen/bigger_text_size" />

    <!-- Pattern View (PROTECTION_PATTERN = 0) -->
    <FrameLayout
        android:id="@+id/vault_pattern_holder"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:visibility="gone">

        <org.fossify.gallery.views.VaultPatternView
            android:id="@+id/vault_pattern_view"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- PIN Pad View (PROTECTION_PIN = 1) -->
    <LinearLayout
        android:id="@+id/vault_pin_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="18dp">

            <org.fossify.gallery.views.VaultPinDotsView
                android:id="@+id/vault_pin_dots"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Legacy dots presentation, kept for when "show a dot per digit" is disabled. -->
            <org.fossify.commons.views.MyTextView
                android:id="@+id/vault_pin_dots_legacy"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center"
                android:letterSpacing="0.3"
                android:textSize="24sp"
                android:visibility="gone" />

            <!-- The sweep travels in the open corridor ABOVE the legacy bullets, mirroring the
                 approved prototype (sweepY, then bullets at sweepY + 20dp). Never center it on
                 the bullet text: that makes the line cross straight through the dots. -->
            <View
                android:id="@+id/vault_unlock_sweep"
                android:layout_width="64dp"
                android:layout_height="4dp"
                android:layout_gravity="top"
                android:background="@drawable/vault_unlock_sweep"
                android:visibility="invisible" />
        </FrameLayout>

        <GridLayout
            android:id="@+id/vault_pin_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alignmentMode="alignBounds"
            android:columnCount="3"
            android:rowCount="4"
            android:useDefaultMargins="true">

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_1"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="78dp"
                android:layout_height="58dp"
                android:fontFamily="sans-serif-medium"
                android:text="1"
                android:textSize="21sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_2"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="78dp"
                android:layout_height="58dp"
                android:fontFamily="sans-serif-medium"
                android:text="2"
                android:textSize="21sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_3"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="78dp"
                android:layout_height="58dp"
                android:fontFamily="sans-serif-medium"
                android:text="3"
                android:textSize="21sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_4"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="78dp"
                android:layout_height="58dp"
                android:fontFamily="sans-serif-medium"
                android:text="4"
                android:textSize="21sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_5"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="78dp"
                android:layout_height="58dp"
                android:fontFamily="sans-serif-medium"
                android:text="5"
                android:textSize="21sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_6"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="78dp"
                android:layout_height="58dp"
                android:fontFamily="sans-serif-medium"
                android:text="6"
                android:textSize="21sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_7"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="78dp"
                android:layout_height="58dp"
                android:fontFamily="sans-serif-medium"
                android:text="7"
                android:textSize="21sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_8"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="78dp"
                android:layout_height="58dp"
                android:fontFamily="sans-serif-medium"
                android:text="8"
                android:textSize="21sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_9"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="78dp"
                android:layout_height="58dp"
                android:fontFamily="sans-serif-medium"
                android:text="9"
                android:textSize="21sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_backspace"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="78dp"
                android:layout_height="58dp"
                android:text="⌫"
                android:textSize="20sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_0"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="78dp"
                android:layout_height="58dp"
                android:fontFamily="sans-serif-medium"
                android:text="0"
                android:textSize="21sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_ok"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="78dp"
                android:layout_height="58dp"
                android:text="✓"
                android:textSize="22sp"
                android:textStyle="bold" />
        </GridLayout>
    </LinearLayout>

    <!-- Full Alphanumeric Password View (PROTECTION_PASSWORD = 3) -->
    <LinearLayout
        android:id="@+id/vault_password_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- The shutter sweep travels in its own 24dp corridor between the lock emblem/status
             label and the input field, mirroring the open space the PIN dots sit in. It must
             never cross the password field itself. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginBottom="10dp">

            <View
                android:id="@+id/vault_unlock_sweep_password"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/vault_unlock_sweep"
                android:visibility="invisible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <org.fossify.commons.views.MyTextInputLayout
                android:id="@+id/vault_password_input_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAutofill="noExcludeDescendants"
                app:endIconMode="password_toggle">

                <org.fossify.gallery.views.VaultPasswordEditText
                    android:id="@+id/vault_password_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textCursorDrawable="@drawable/vault_text_cursor"
                    android:imeOptions="actionDone|flagNoPersonalizedLearning|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textPassword|textNoSuggestions"
                    android:longClickable="false"
                    android:maxLines="1"
                    android:singleLine="true" />
            </org.fossify.commons.views.MyTextInputLayout>

            <!-- Fixed-width slot so the 44dp button centres in the space between the field and the screen edge. -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="wrap_content">

                <org.fossify.commons.views.MyButton
                    android:id="@+id/vault_password_ok_btn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/ok" />

                <!-- A vector icon is geometrically centred; the "✓" glyph sits low in the font box. -->
                <ImageView
                    android:id="@+id/vault_password_ok_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:focusable="false"
                    android:src="@drawable/ic_onboarding_check" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Password-reminder verification only (HTML screen 5): bottom-right recovery link. -->
    <org.fossify.commons.views.MyTextView
        android:id="@+id/vault_forgot_password_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:text="@string/vault_password_reminder_forgot_action"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Guidance only: shown while creating a vault so the chosen secret can be assessed. -->
    <LinearLayout
        android:id="@+id/vault_strength_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/vault_strength_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/vault_strength_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textSize="12sp" />
    </LinearLayout>

    <org.fossify.commons.views.MyTextView
        android:id="@+id/vault_brute_force_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="@dimen/normal_margin"
        android:background="?attr/selectableItemBackground"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/brute_force_time_title"
        android:visibility="gone" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/vault_no_recovery_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/normal_margin"
        android:gravity="center"
        android:paddingHorizontal="@dimen/small_margin"
        android:text="@string/vault_no_recovery_warning"
        android:textSize="@dimen/smaller_text_size"
        android:visibility="gone" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/vault_biometric_btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:drawablePadding="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/use_biometrics"
        android:textSize="14sp"
        android:visibility="gone" />
</org.fossify.gallery.views.MaxWidthLinearLayout>