<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/activity_margin"
        android:paddingTop="@dimen/medium_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:paddingBottom="@dimen/medium_margin">

        <RadioGroup
            android:id="@+id/skipped_crypto_files_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/skipped_crypto_files_mode_ask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/medium_margin"
                android:paddingBottom="@dimen/medium_margin"
                android:text="@string/skipped_crypto_files_ask" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/skipped_crypto_files_mode_keep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/medium_margin"
                android:paddingBottom="@dimen/medium_margin"
                android:text="@string/skipped_crypto_files_keep" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/skipped_crypto_files_mode_delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/medium_margin"
                android:paddingBottom="@dimen/medium_margin"
                android:text="@string/skipped_crypto_files_delete" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
