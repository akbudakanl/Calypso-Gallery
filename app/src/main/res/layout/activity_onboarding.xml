<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboarding_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/pane_welcome"
        layout="@layout/layout_onboarding_welcome"
        android:visibility="gone" />

    <include
        android:id="@+id/pane_media_permission"
        layout="@layout/layout_onboarding_media_permission"
        android:visibility="gone" />

    <include
        android:id="@+id/pane_all_files"
        layout="@layout/layout_onboarding_all_files"
        android:visibility="gone" />
</FrameLayout>
