<resources>

    <style name="AppTheme" parent="AppTheme.Base">
        <!-- Commons' theme tints text-selection handles green. Use the same theme-aware
             colour as the caret so handles match light and dark palettes everywhere. -->
        <item name="android:textSelectHandle">@drawable/calypso_text_select_handle_middle</item>
        <item name="android:textSelectHandleLeft">@drawable/calypso_text_select_handle_left</item>
        <item name="android:textSelectHandleRight">@drawable/calypso_text_select_handle_right</item>
    </style>

    <!-- Applied to password fields so the caret uses the theme text colour instead of the library's green accent. -->
    <style name="VaultCursorTheme">
        <item name="android:textCursorDrawable">@drawable/vault_text_cursor</item>
    </style>

    <!-- Only org.fossify.commons' tab_biometric_id.xml uses this style. Its default background is
         tied to the green fallback primary color, which clashes with this fork's neutral palette. -->
    <style name="ColoredButtonStyle" parent="@android:style/Widget.TextView">
        <item name="android:textSize">@dimen/bigger_text_size</item>
        <item name="android:paddingStart">@dimen/big_margin</item>
        <item name="android:paddingEnd">@dimen/big_margin</item>
        <item name="android:paddingTop">@dimen/normal_margin</item>
        <item name="android:paddingBottom">@dimen/normal_margin</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:background">@drawable/biometric_button_background</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- Album header typography used by MediaActivity's two-line toolbar. Mirrors the
         in-phone header of 03-virtual-albums.png: bold title with tight tracking and a
         small, quiet count line underneath. -->
    <style name="MediaAlbumToolbarTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="MediaAlbumToolbarSubtitle">
        <item name="android:textSize">12.5sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="SettingsSubHeadingStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/settings_label_start_margin</item>
        <item name="android:paddingEnd">@dimen/settings_label_start_margin</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalypsoCardRowStyle">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="FullScreenTheme.Base" parent="AppTheme">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="FullScreenTheme" parent="FullScreenTheme.Base" />
</resources>
