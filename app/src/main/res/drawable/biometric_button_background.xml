<?xml version="1.0" encoding="utf-8"?>
<!-- The inherited commons biometric tab used a green primary fallback theme. Fill with the
     theme's primary text color so the button is light in dark themes and dark in light themes;
     commons sets its label to the contrast color of the app primary, keeping both themes legible. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?android:attr/textColorPrimary" />
    <corners android:radius="8dp" />
</shape>
