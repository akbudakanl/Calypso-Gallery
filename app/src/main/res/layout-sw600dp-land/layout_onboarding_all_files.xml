<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding_all_files_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/onboarding_all_files_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <org.fossify.gallery.views.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingTop="24dp"
            android:paddingEnd="48dp"
            android:paddingBottom="24dp"
            app:maxWidth="960dp">

            <!-- Left Column: Emblem, Title, Description -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.9"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="start|center_vertical"
                android:orientation="vertical"
                android:paddingEnd="36dp">

                <!-- Emblem -->
                <FrameLayout
                    android:id="@+id/onboarding_all_files_emblem"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_gravity="start"
                    android:layout_marginBottom="18dp">

                    <View
                        android:id="@+id/onboarding_all_files_halo"
                        android:layout_width="86dp"
                        android:layout_height="86dp"
                        android:layout_gravity="center" />

                    <FrameLayout
                        android:id="@+id/onboarding_all_files_emblem_core"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_gravity="center">

                        <ImageView
                            android:id="@+id/onboarding_all_files_emblem_icon"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_onboarding_folder" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/onboarding_all_files_badge_dot"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:id="@+id/onboarding_all_files_badge_icon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_onboarding_check" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/onboarding_all_files_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:breakStrategy="balanced"
                    android:gravity="start"
                    android:letterSpacing="-0.02"
                    android:text="@string/onboarding_all_files_title"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/onboarding_all_files_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:breakStrategy="balanced"
                    android:gravity="start"
                    android:hyphenationFrequency="normal"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/onboarding_all_files_desc"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Right Column: 3 Feature Cards + Actions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <!-- Card 1: Vault & Hidden Folders -->
                <LinearLayout
                    android:id="@+id/onboarding_af_card_vault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <FrameLayout
                        android:id="@+id/onboarding_af_icon_box_vault"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="1dp"
                        android:layout_marginEnd="14dp">

                        <ImageView
                            android:id="@+id/onboarding_af_icon_vault"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_onboarding_vault_lock" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/onboarding_af_vault_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:breakStrategy="balanced"
                            android:hyphenationFrequency="normal"
                            android:text="@string/onboarding_all_files_vault_title"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/onboarding_af_vault_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:breakStrategy="balanced"
                            android:hyphenationFrequency="normal"
                            android:lineSpacingMultiplier="1.25"
                            android:text="@string/onboarding_all_files_vault_desc"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card 2: Auto-backup Favorites & Virtual Albums -->
                <LinearLayout
                    android:id="@+id/onboarding_af_card_backup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <FrameLayout
                        android:id="@+id/onboarding_af_icon_box_backup"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="1dp"
                        android:layout_marginEnd="14dp">

                        <ImageView
                            android:id="@+id/onboarding_af_icon_backup"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_onboarding_backup" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/onboarding_af_backup_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:breakStrategy="balanced"
                            android:hyphenationFrequency="normal"
                            android:text="@string/onboarding_all_files_backup_title"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/onboarding_af_backup_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:breakStrategy="balanced"
                            android:hyphenationFrequency="normal"
                            android:lineSpacingMultiplier="1.25"
                            android:text="@string/onboarding_all_files_backup_desc"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card 3: Still Offline -->
                <LinearLayout
                    android:id="@+id/onboarding_af_card_offline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <FrameLayout
                        android:id="@+id/onboarding_af_icon_box_offline"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="1dp"
                        android:layout_marginEnd="14dp">

                        <ImageView
                            android:id="@+id/onboarding_af_icon_offline"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_onboarding_shield" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/onboarding_af_offline_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:breakStrategy="balanced"
                            android:hyphenationFrequency="normal"
                            android:text="@string/onboarding_all_files_offline_title"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/onboarding_af_offline_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:breakStrategy="balanced"
                            android:hyphenationFrequency="normal"
                            android:lineSpacingMultiplier="1.25"
                            android:text="@string/onboarding_all_files_offline_desc"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <org.fossify.gallery.views.MaxWidthLinearLayout
                    android:id="@+id/onboarding_all_files_footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/onboarding_all_files_grant_btn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:letterSpacing="0"
                        android:text="@string/onboarding_grant_access"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="26dp"
                        app:elevation="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/onboarding_all_files_skip_btn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:letterSpacing="0"
                        android:text="@string/onboarding_not_now"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        app:cornerRadius="22dp" />
                </org.fossify.gallery.views.MaxWidthLinearLayout>
            </LinearLayout>
        </org.fossify.gallery.views.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>
